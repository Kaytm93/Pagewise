# Nur unkritische Konfiguration. API-Keys gehören NICHT hierher,
# sondern in die App (macOS-Keychain bzw. Secrets-Datei im Datenverzeichnis).

# Datenverzeichnis. Muss außerhalb des Repos liegen, sonst startet die App nicht.
# Standard: macOS ~/Library/Application Support/Pagewise
#           Linux $XDG_DATA_HOME/pagewise (sonst ~/.local/share/pagewise)
# PAGEWISE_DATA_DIR=

# Port des lokalen Servers
PAGEWISE_PORT=3000

# Bind-Adresse. Erlaubt sind nur Loopback-Adressen (127.0.0.1, ::1, localhost).
# PAGEWISE_HOST=127.0.0.1

# Nur für Docker: erlaubt 0.0.0.0 im Container. Den Port dann ausschließlich
# an 127.0.0.1 des Hosts veröffentlichen ("127.0.0.1:3000:3000").
# PAGEWISE_ALLOW_NON_LOOPBACK=1
