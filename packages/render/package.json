{
  "name": "@pagewise/render",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Gemeinsamer Kern für Hefteinträge: Blöcke erkennen, prüfen, zu sicherem SVG und HTML machen. Läuft im Browser, im Server und später im Worker.",
  "exports": {
    ".": "./src/index.ts",
    "./math": "./src/math.ts",
    "./graph": "./src/graph/index.ts",
    "./mol": "./src/mol/index.ts",
    "./abc": "./src/abc.ts",
    "./smiles": "./src/smiles.ts",
    "./sanitize": "./src/sanitize.ts",
    "./validate": "./src/validate.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "abcjs": "6.7.1",
    "dompurify": "3.4.16",
    "katex": "0.19.0",
    "smiles-drawer": "2.4.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/node": "^22.0.0",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
